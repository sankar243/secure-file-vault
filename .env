# Environment Variables for Secure File Vault

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS Whitelist (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL 18)
DATABASE_URL=postgresql://vault_user:vault_secure_password_2026@localhost:5433/secure_file_vault?schema=public

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin_key_2026
MINIO_SECRET_KEY=minio_admin_secret_secure_2026
MINIO_BUCKET_NAME=encrypted-vault-files

# Master Key Encryption Key (KEK) for Envelope Encryption (32 bytes / 64 hex characters)
MASTER_KEY_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Session Secret (Cookie Signing & Encryption)
SESSION_SECRET=super_secret_session_key_vault_production_ready_32chars!

# CSRF Secret
CSRF_SECRET=super_secret_csrf_token_signing_key_32chars_long!

# Security Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=900000

# Auth Cookie Configuration
COOKIE_NAME=sfv_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
